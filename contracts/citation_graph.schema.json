{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equations-history/contracts/citation_graph.schema.json",
  "title": "Citation graph (producer: tool-lit-review, papers/graph.json)",
  "type": "object",
  "required": ["nodes", "edges", "sources"],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}v[0-9]+$"}
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}v[0-9]+$"}
      }
    },
    "sources": {
      "type": "object",
      "required": ["openalex", "text_arxiv_ids", "bibliography_titles"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
